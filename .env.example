# Copy to .env and fill in. NEVER commit .env (gitignored).
OPENROUTER_API_KEY=
# Optional — only if doing CoT-resampling/partial-refill work (thought-anchors style):
NEBIUS_API_KEY=
# Hugging Face token (read scope) — only needed for gated repos; Qwen3.5 is Apache-2.0 and ungated.
HF_TOKEN=
# Runpod box, once rented: "root@<ip> -p <port>" as printed in the Runpod "SSH over exposed TCP" line.
POD_SSH=
